{
  "_comment": "Rules evaluated top-to-bottom, first match wins. 'default' applies if nothing matches. Colors match the original Streamlit prototype exactly. metric_key matches the raw fundamentals field name used in raw_fundamentals.json.",
  "colors": {
    "green": "#06d6a0",
    "orange": "#ff9f1c",
    "red": "#ff4d4d",
    "pink": "#f72585",
    "gray": "#666666"
  },
  "income_statement": [
    {"metric_key": "net_profit_margin", "label": "Net Profit Margin", "format": "pct",
     "rules": [{"gt": 0.10, "label": "Healthy", "color": "green"}, {"gt": 0.05, "label": "Moderate", "color": "orange"}],
     "default": {"label": "Weak", "color": "red"}},
    {"metric_key": "gross_margin", "label": "Gross Margin", "format": "pct",
     "rules": [{"gt": 0.40, "label": "Strong", "color": "green"}, {"gt": 0.20, "label": "Moderate", "color": "orange"}],
     "default": {"label": "Low", "color": "red"}},
    {"metric_key": "ebitda", "label": "EBITDA", "format": "cr",
     "rules": [{"gt": 0, "label": "Profitable", "color": "green"}],
     "default": {"label": "Unprofitable", "color": "red"}},
    {"metric_key": "revenue_growth", "label": "Revenue Growth", "format": "pct",
     "rules": [{"gt": 0.15, "label": "High Growth", "color": "green"}, {"gt": 0, "label": "Growing", "color": "orange"}],
     "default": {"label": "Declining", "color": "red"}},
    {"metric_key": "total_revenue", "label": "Total Revenue", "format": "cr", "rules": [], "default": {"label": "", "color": "gray"}},
    {"metric_key": "net_income", "label": "Net Income", "format": "cr",
     "rules": [{"gt": 0, "label": "Profit", "color": "green"}],
     "default": {"label": "Loss", "color": "red"}},
    {"metric_key": "operating_margin", "label": "Operating Margin", "format": "pct",
     "rules": [{"gt": 0.15, "label": "Strong", "color": "green"}, {"gt": 0.05, "label": "Fair", "color": "orange"}],
     "default": {"label": "Weak", "color": "red"}},
    {"metric_key": "earnings_growth", "label": "Earnings Growth", "format": "pct",
     "rules": [{"gt": 0.10, "label": "Accelerating", "color": "green"}, {"gt": 0, "label": "Stable", "color": "orange"}],
     "default": {"label": "Declining", "color": "red"}}
  ],
  "balance_sheet": [
    {"metric_key": "current_ratio", "label": "Current Ratio", "format": "x",
     "rules": [{"gt": 1.5, "label": "Strong", "color": "green"}, {"gt": 1.0, "label": "Adequate", "color": "orange"}],
     "default": {"label": "Risky", "color": "red"}},
    {"metric_key": "quick_ratio", "label": "Quick Ratio", "format": "x",
     "rules": [{"gt": 1.0, "label": "Liquid", "color": "green"}, {"gt": 0.5, "label": "Tight", "color": "orange"}],
     "default": {"label": "Illiquid", "color": "red"}},
    {"metric_key": "de_ratio", "label": "Debt-to-Equity (D/E)", "format": "pctx",
     "rules": [{"lt": 50, "label": "Conservative", "color": "green"}, {"lt": 150, "label": "Moderate", "color": "orange"}],
     "default": {"label": "High Leverage", "color": "red"}},
    {"metric_key": "working_capital", "label": "Working Capital", "format": "cr",
     "rules": [{"gt": 0, "label": "Positive", "color": "green"}],
     "default": {"label": "Negative", "color": "red"}},
    {"metric_key": "total_cash", "label": "Total Cash", "format": "cr", "rules": [], "default": {"label": "", "color": "gray"}},
    {"metric_key": "total_debt", "label": "Total Debt", "format": "cr", "rules": [], "default": {"label": "", "color": "gray"}},
    {"metric_key": "roe", "label": "ROE — Return on Equity", "format": "pct",
     "rules": [{"gt": 0.20, "label": "Excellent", "color": "green"}, {"gt": 0.10, "label": "Good", "color": "orange"}],
     "default": {"label": "Low", "color": "red"}},
    {"metric_key": "roa", "label": "ROA — Return on Assets", "format": "pct",
     "rules": [{"gt": 0.10, "label": "Efficient", "color": "green"}, {"gt": 0.05, "label": "Fair", "color": "orange"}],
     "default": {"label": "Low", "color": "red"}}
  ],
  "cash_flow": [
    {"metric_key": "operating_cf", "label": "Operating Cash Flow (OCF)", "format": "cr",
     "rules": [{"gt": 0, "label": "Cash Generating", "color": "green"}],
     "default": {"label": "Cash Burning", "color": "red"}},
    {"metric_key": "free_cf", "label": "Free Cash Flow (FCF)", "format": "cr",
     "rules": [{"gt": 0, "label": "FCF Positive", "color": "green"}],
     "default": {"label": "FCF Negative", "color": "red"}}
  ],
  "valuation": [
    {"metric_key": "pe_ratio", "label": "P/E Ratio", "format": "x",
     "rules": [{"gt": 0, "lt": 15, "label": "Value", "color": "green"}, {"gte": 15, "lt": 25, "label": "Fair", "color": "orange"}, {"gte": 25, "label": "Growth Premium", "color": "pink"}],
     "default": {"label": "N/A", "color": "gray"}},
    {"metric_key": "price_to_book", "label": "Price-to-Book (P/B)", "format": "x",
     "rules": [{"gt": 0, "lt": 1, "label": "Undervalued", "color": "green"}, {"gte": 1, "lt": 3, "label": "Fair", "color": "orange"}],
     "default": {"label": "Premium", "color": "pink"}},
    {"metric_key": "ev_to_ebitda", "label": "EV/EBITDA", "format": "x",
     "rules": [{"gt": 0, "lt": 10, "label": "Cheap", "color": "green"}, {"gte": 10, "lt": 15, "label": "Fair", "color": "orange"}],
     "default": {"label": "Expensive", "color": "pink"}},
    {"metric_key": "dividend_yield", "label": "Dividend Yield", "format": "pct",
     "rules": [{"gt": 0.03, "label": "Income Stock", "color": "green"}, {"gt": 0, "label": "Modest", "color": "orange"}],
     "default": {"label": "No Dividend", "color": "gray"}},
    {"metric_key": "beta", "label": "Beta (Market Sensitivity)", "format": "raw",
     "rules": [{"lt": 0.8, "label": "Defensive", "color": "green"}, {"lt": 1.2, "label": "Market-like", "color": "orange"}],
     "default": {"label": "Aggressive", "color": "pink"}},
    {"metric_key": "peg_ratio", "label": "PEG Ratio", "format": "raw",
     "rules": [{"gt": 0, "lt": 1, "label": "Undervalued", "color": "green"}, {"gte": 1, "lt": 2, "label": "Fair", "color": "orange"}],
     "default": {"label": "Overvalued", "color": "pink"}},
    {"metric_key": "rev_per_employee", "label": "Revenue per Employee", "format": "cr", "rules": [], "default": {"label": "", "color": "gray"}},
    {"metric_key": "payout_ratio", "label": "Payout Ratio", "format": "pct",
     "rules": [{"gt": 0, "lt": 0.60, "label": "Sustainable", "color": "green"}, {"gte": 0.60, "label": "High", "color": "orange"}],
     "default": {"label": "None", "color": "gray"}}
  ]
}
